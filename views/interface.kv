<LibraryItem@BoxLayout>:
    orientation: 'horizontal'
    size_hint_y: None
    height: '72dp'
    spacing: '8dp'
    padding: '8dp'

    titulo: ''
    artista: ''
    duracion: ''
    index: -1

    BoxLayout:
        orientation: 'vertical'
        spacing: '2dp'

        Label:
            text: root.titulo
            bold: True
            font_size: '16sp'
            text_size: self.size
            halign: 'left'
            valign: 'middle'

        Label:
            text: root.artista
            font_size: '14sp'
            color: 0.7, 0.7, 0.7, 1
            text_size: self.size
            halign: 'left'
            valign: 'middle'

        Label:
            text: 'Duración: ' + root.duracion
            font_size: '12sp'
            color: 0.55, 0.55, 0.55, 1
            text_size: self.size
            halign: 'left'
            valign: 'middle'

    Button:
        text: 'X'
        size_hint_x: None
        width: '50dp'
        background_color: 0.8, 0.2, 0.2, 1
        on_press: app.controller.delete_song(root.index)


<PlaylistSelectItem@BoxLayout>:
    orientation: 'horizontal'
    size_hint_y: None
    height: '72dp'
    spacing: '8dp'
    padding: '8dp'

    titulo: ''
    artista: ''
    duracion: ''
    index: -1
    selected: False

    BoxLayout:
        orientation: 'vertical'
        spacing: '2dp'

        Label:
            text: root.titulo
            bold: True
            font_size: '16sp'
            text_size: self.size
            halign: 'left'
            valign: 'middle'

        Label:
            text: root.artista + ' - ' + root.duracion
            font_size: '13sp'
            color: 0.7, 0.7, 0.7, 1
            text_size: self.size
            halign: 'left'
            valign: 'middle'

    Button:
        text: 'Seleccionada' if root.selected else 'Seleccionar'
        size_hint_x: None
        width: '120dp'
        background_color: (0.2, 0.7, 0.3, 1) if root.selected else (0.2, 0.6, 1, 1)
        on_press: app.controller.toggle_select_song(root.index)


<PlaylistItem@BoxLayout>:
    orientation: 'horizontal'
    size_hint_y: None
    height: '58dp'
    spacing: '8dp'
    padding: '8dp'

    titulo: ''
    artista: ''
    duracion: ''

    BoxLayout:
        orientation: 'vertical'
        spacing: '2dp'

        Label:
            text: root.titulo
            bold: True
            font_size: '15sp'
            text_size: self.size
            halign: 'left'
            valign: 'middle'

        Label:
            text: root.artista + ' - ' + root.duracion
            font_size: '13sp'
            color: 0.7, 0.7, 0.7, 1
            text_size: self.size
            halign: 'left'
            valign: 'middle'


ScreenManager:

    Screen:
        name: 'library_screen'

        BoxLayout:
            orientation: 'vertical'
            padding: '15dp'
            spacing: '10dp'

            Label:
                text: 'Biblioteca Musical Personal'
                font_size: '24sp'
                bold: True
                size_hint_y: None
                height: '38dp'

            Label:
                text: 'Colección de canciones con listas enlazadas'
                font_size: '14sp'
                color: 0.6, 0.6, 0.6, 1
                size_hint_y: None
                height: '24dp'

            BoxLayout:
                orientation: 'horizontal'
                spacing: '8dp'
                size_hint_y: None
                height: '42dp'

                TextInput:
                    id: search_input
                    hint_text: 'Buscar por título o artista'
                    multiline: False

                Button:
                    id: search_button
                    text: 'Buscar'
                    size_hint_x: None
                    width: '90dp'
                    background_color: 0.3, 0.7, 0.3, 1

                Button:
                    id: clear_search_button
                    text: 'Todo'
                    size_hint_x: None
                    width: '70dp'
                    background_color: 0.5, 0.5, 0.5, 1

            BoxLayout:
                orientation: 'horizontal'
                spacing: '8dp'
                size_hint_y: None
                height: '42dp'

                Button:
                    id: go_add_button
                    text: 'Añadir Canción'
                    background_color: 0.2, 0.6, 1, 1

                Button:
                    id: go_playlist_button
                    text: 'Ir a Playlist'
                    background_color: 0.7, 0.4, 1, 1

                Button:
                    id: show_all_button
                    text: 'Mostrar Biblioteca'
                    background_color: 0.5, 0.5, 0.5, 1

            Label:
                id: library_status_label
                text: 'Estado: listo'
                font_size: '13sp'
                color: 0.6, 0.6, 0.6, 1
                size_hint_y: None
                height: '25dp'

            Label:
                text: 'Canciones guardadas'
                font_size: '18sp'
                bold: True
                size_hint_y: None
                height: '30dp'

            RecycleView:
                id: library_list
                viewclass: 'LibraryItem'

                RecycleBoxLayout:
                    default_size: None, dp(72)
                    default_size_hint: 1, None
                    size_hint_y: None
                    height: self.minimum_height
                    orientation: 'vertical'
                    spacing: '6dp'


    Screen:
        name: 'add_screen'

        BoxLayout:
            orientation: 'vertical'
            padding: '15dp'
            spacing: '12dp'

            Label:
                text: 'Añadir Canción'
                font_size: '24sp'
                bold: True
                size_hint_y: None
                height: '40dp'

            Label:
                text: 'Ingrese los datos de la canción'
                font_size: '14sp'
                color: 0.6, 0.6, 0.6, 1
                size_hint_y: None
                height: '25dp'

            TextInput:
                id: title_input
                hint_text: 'Título de la canción'
                multiline: False
                size_hint_y: None
                height: '42dp'

            TextInput:
                id: artist_input
                hint_text: 'Artista'
                multiline: False
                size_hint_y: None
                height: '42dp'

            TextInput:
                id: duration_input
                hint_text: 'Duración, ejemplo: 3:45'
                multiline: False
                size_hint_y: None
                height: '42dp'

            Label:
                id: add_status_label
                text: 'Estado: esperando datos'
                font_size: '13sp'
                color: 0.6, 0.6, 0.6, 1
                size_hint_y: None
                height: '25dp'

            BoxLayout:
                orientation: 'horizontal'
                spacing: '8dp'
                size_hint_y: None
                height: '45dp'

                Button:
                    id: save_song_button
                    text: 'Guardar Canción'
                    background_color: 0.2, 0.7, 0.3, 1

                Button:
                    id: back_from_add_button
                    text: 'Volver'
                    background_color: 0.5, 0.5, 0.5, 1

            Widget:


    Screen:
        name: 'playlist_screen'

        BoxLayout:
            orientation: 'vertical'
            padding: '15dp'
            spacing: '10dp'

            Label:
                text: 'Gestión de Playlist'
                font_size: '24sp'
                bold: True
                size_hint_y: None
                height: '40dp'

            TextInput:
                id: playlist_name_input
                hint_text: 'Nombre de la playlist'
                multiline: False
                size_hint_y: None
                height: '42dp'

            BoxLayout:
                orientation: 'horizontal'
                spacing: '8dp'
                size_hint_y: None
                height: '42dp'

                Button:
                    id: create_playlist_button
                    text: 'Crear Playlist'
                    background_color: 0.7, 0.4, 1, 1

                Button:
                    id: clear_selection_button
                    text: 'Limpiar Selección'
                    background_color: 0.5, 0.5, 0.5, 1

            BoxLayout:
                orientation: 'horizontal'
                spacing: '8dp'
                size_hint_y: None
                height: '42dp'

                Button:
                    id: delete_playlist_button
                    text: 'Eliminar Playlist'
                    background_color: 0.8, 0.2, 0.2, 1

                Button:
                    id: back_from_playlist_button
                    text: 'Volver'
                    background_color: 0.5, 0.5, 0.5, 1

            Label:
                id: playlist_status_label
                text: 'Estado: listo'
                font_size: '13sp'
                color: 0.6, 0.6, 0.6, 1
                size_hint_y: None
                height: '25dp'

            Label:
                text: 'Seleccionar canciones de la biblioteca'
                font_size: '17sp'
                bold: True
                size_hint_y: None
                height: '28dp'

            RecycleView:
                id: playlist_available_list
                viewclass: 'PlaylistSelectItem'
                size_hint_y: 0.55

                RecycleBoxLayout:
                    default_size: None, dp(72)
                    default_size_hint: 1, None
                    size_hint_y: None
                    height: self.minimum_height
                    orientation: 'vertical'
                    spacing: '6dp'

            Label:
                id: playlist_title_label
                text: 'Playlist: sin nombre'
                font_size: '17sp'
                bold: True
                size_hint_y: None
                height: '30dp'

            RecycleView:
                id: playlist_list
                viewclass: 'PlaylistItem'
                size_hint_y: 0.45

                RecycleBoxLayout:
                    default_size: None, dp(58)
                    default_size_hint: 1, None
                    size_hint_y: None
                    height: self.minimum_height
                    orientation: 'vertical'
                    spacing: '6dp'
